{
  "extends": "@technabit/typescript-config/nestjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "strict": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "paths": {
      "@technabit/backend-api/*": [
        "src/*"
      ],
      "@/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.d.ts",
    "../../packages/**/dist"
  ]
}
