{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "entryFile": "main",
  "compilerOptions": {
    "tsConfigPath": "./tsconfig.build.json",
    "builder": "swc",
    "typeCheck": true,
    "deleteOutDir": true,
    "assets": [
      { "include": "**/i18n/**/*", "watchAssets": true },
      { "include": "**/*.hbs", "watchAssets": true }
    ]
  }
}

