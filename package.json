{
  "name": "technabit-nestjs-stack",
  "version": "0.0.0",
  "description": "Technabit Nest.js Stack",
  "author": "Technabit e.U. <hello@technabit.eu>",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "start:api": "cross-env IS_WORKER=false pnpm --filter @technabit/backend-api start --entryFile main",
    "start:api:dev": "cross-env IS_WORKER=false pnpm --filter @technabit/backend-api start --entryFile main --watch",
    "build:api": "turbo run build --filter=@technabit/backend-api",
    "start:worker": "cross-env IS_WORKER=true pnpm --filter @technabit/backend-api start --entryFile worker",
    "start:worker:dev": "cross-env IS_WORKER=true pnpm --filter @technabit/backend-api start --entryFile worker --watch",
    "docker:dev:up": "node ./bin/compose.mjs dev up",
    "docker:dev:down": "node ./bin/compose.mjs dev down",
    "docker:prod:up": "node ./bin/compose.mjs prod up --build --force-recreate",
    "docker:prod:down": "node ./bin/compose.mjs prod down",
    "docker:app:logs": "node ./bin/compose.mjs dev logs -f backend-api",
    "email:dev": "email dev --dir ./packages/nest-core/src/shared/mail/templates --port 3002",
    "email:build": "wait-on ./packages/nest-core/dist/shared/mail && ts-node ./packages/nest-core/scripts/mail.build.ts",
    "email:watch": "pnpm run email:build -w",
    "lint": "eslint '{apps,packages,src,test}/**/*.ts' --fix",
    "format": "prettier --write 'apps/**/*.ts' 'packages/**/*.ts'",
    "prepare": "husky || true",
    "graph:app": "madge ./apps/backend-api/src/main.ts --image ./.tmp/graph.png",
    "graph:circular": "madge --circular ./apps/backend-api/src/main.ts --image ./.tmp/circular.png",
    "commit": "git-cz"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^9.12.0",
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.4",
    "@prisma/adapter-pg": "6.16.0",
    "@prisma/client": "6.16.2",
    "@react-email/components": "0.0.41",
    "@react-email/render": "1.1.2",
    "@swc/cli": "^0.4.0",
    "@swc/core": "^1.7.35",
    "@swc/register": "^0.1.10",
    "@types/compression": "^1.7.5",
    "@types/eslint__js": "^8.42.3",
    "@types/jest": "^29.5.13",
    "@types/lodash": "^4.17.13",
    "@types/mime-types": "^2.1.4",
    "@types/ms": "^0.7.34",
    "@types/node": "^22.7.5",
    "@types/nodemailer": "^6.4.16",
    "@types/pg": "^8.11.14",
    "@types/react": "^19.1.5",
    "@types/supertest": "^6.0.2",
    "chokidar": "^4.0.3",
    "concurrently": "^9.1.2",
    "copyfiles": "^2.4.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.6",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.10",
    "madge": "^8.0.0",
    "nestjs-spelunker": "^1.3.1",
    "prettier": "^3.3.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "prisma": "^6.16.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-email": "4.0.15",
    "sass-embedded": "^1.79.5",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "turbo": "^2.2.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.1",
    "wait-on": "^8.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client"
    ],
    "overrides": {
      "fastify": "4.29.1",
      "@fastify/cookie": "9.4.0",
      "rxjs": "7.8.2"
    }
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "packageManager": "pnpm@9.12.0+sha256.a61b67ff6cc97af864564f4442556c22a04f2e5a7714fbee76a1011361d9b726"
}
