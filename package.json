{
  "name": "technabit-nestjs-stack",
  "version": "0.0.0",
  "description": "Technabit Nest.js Stack",
  "author": "Technabit e.U. <hello@technabit.eu>",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:server": "pnpm --filter @technabit/backend-api dev",
    "start:server": "pnpm --filter @technabit/backend-api start",
    "repo:clean:src": "ts-node ./scripts/clean-src-build.ts",
    "build:server": "turbo run build --filter=@technabit/backend-api",
    "build": "turbo run build",
    "lint:all": "turbo run lint --parallel",
    "test:all": "turbo run test --parallel",
    "start:app": "nest start",
    "start:app:dev": "nest start --watch",
    "start:api": "cross-env IS_WORKER=false nest start --entryFile main",
    "start:api:dev": "cross-env IS_WORKER=false nest start --entryFile main --watch",
    "start:worker": "pnpm --filter @technabit/backend-worker start",
    "start:worker:dev": "pnpm --filter @technabit/backend-worker dev",
    "dev:worker": "pnpm --filter @technabit/backend-worker dev",
    "build:worker": "pnpm --filter @technabit/backend-worker build",
    "start": "concurrently -n api,email -c cyan,green 'nest start' 'pnpm email:build'",
    "start:dev": "concurrently -n api,email -c cyan,green 'nest start --watch' 'pnpm email:watch'",
    "start:debug": "concurrently -n api,email -c cyan,green 'nest start --debug --watch' 'pnpm email:watch'",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules pnpm exec jest",
    "test:watch": "pnpm run test --watch",
    "test:cov": "pnpm run test --coverage",
    "test:debug": "cross-env NODE_OPTIONS='--inspect-brk --experimental-vm-modules' node -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "pnpm run test --config ./test/jest-e2e.json",
    "repo:cleanup": "ts-node ./scripts/cleanup-legacy.ts",
    "docker:dev:up": "node ./bin/compose.mjs dev up",
    "docker:dev:down": "node ./bin/compose.mjs dev down",
    "docker:prod:up": "node ./bin/compose.mjs prod up --build --force-recreate",
    "docker:prod:down": "node ./bin/compose.mjs prod down",
    "docker:app:logs": "node ./bin/compose.mjs dev logs -f backend-api",
    "email:dev": "email dev --dir ./packages/nest-core/src/shared/mail/templates --port 3002",
    "email:build": "wait-on ./packages/nest-core/dist/shared/mail && ts-node ./scripts/mail.build.ts",
    "email:watch": "pnpm run email:build -w",
    "lint": "eslint '{apps,packages,src,test}/**/*.ts' --fix",
    "format": "prettier --write 'apps/**/*.ts' 'packages/**/*.ts' 'test/**/*.ts'",
    "prepare": "husky || true",
    "graph:app": "madge ./apps/backend-api/src/main.ts --image ./.tmp/graph.png",
    "graph:circular": "madge --circular ./apps/backend-api/src/main.ts --image ./.tmp/circular.png",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed"
  },
  "dependencies": {},
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^9.12.0",
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.4",
    "@react-email/components": "0.0.41",
    "@react-email/render": "1.1.2",
    "@swc/cli": "^0.4.0",
    "@swc/core": "^1.7.35",
    "@swc/register": "^0.1.10",
    "@types/compression": "^1.7.5",
    "@types/eslint__js": "^8.42.3",
    "@types/jest": "^29.5.13",
    "@types/lodash": "^4.17.13",
    "@types/mime-types": "^2.1.4",
    "@types/ms": "^0.7.34",
    "@types/node": "^22.7.5",
    "@types/nodemailer": "^6.4.16",
    "@types/pg": "^8.11.14",
    "@types/react": "^19.1.5",
    "@types/supertest": "^6.0.2",
    "chokidar": "^4.0.3",
    "concurrently": "^9.1.2",
    "copyfiles": "^2.4.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.6",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.10",
    "madge": "^8.0.0",
    "nestjs-spelunker": "^1.3.1",
    "prettier": "^3.3.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-email": "4.0.15",
    "sass-embedded": "^1.79.5",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.1",
    "wait-on": "^8.0.3",
    "prisma": "^6.0.0",
    "turbo": "^2.2.3"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client"
    ],
    "overrides": {
      "rxjs": "7.8.2"
    }
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "optionalDependencies": {},
  "packageManager": "pnpm@9.12.0+sha256.a61b67ff6cc97af864564f4442556c22a04f2e5a7714fbee76a1011361d9b726"
}
