{
  "extends": "@technabit/typescript-config/nestjs.json",
  "compilerOptions": {
    "strict": true,
    "incremental": false,
    "rootDir": "./src",
    "outDir": "./dist",
    "baseUrl": ".",
    "importHelpers": false,
    "paths": {
      "@/core/*": [
        "src/*"
      ],
      "rxjs": [
        "../../node_modules/rxjs"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
