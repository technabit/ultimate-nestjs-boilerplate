{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env",
    "**/.env.local",
    "**/.env.development",
    "**/.env.production",
    "**/.env.docker",
    "**/.env.*local"
  ],
  "globalEnv": [
    "NODE_ENV",
    "APP_PORT",
    "APP_WORKER_PORT",
    "DATABASE_URL",
    "REDIS_HOST",
    "REDIS_PORT",
    "REDIS_PASSWORD",
    "APP_CORS_ORIGIN",
    "APP_DEBUG",
    "APP_FALLBACK_LANGUAGE",
    "APP_LOCAL_FILE_UPLOAD",
    "APP_LOGGING",
    "APP_LOG_LEVEL",
    "APP_LOG_SERVICE",
    "APP_NAME",
    "APP_URL",
    "AUTH_SECRET",
    "AWS_KEY",
    "AWS_REGION",
    "AWS_S3_BUCKET",
    "AWS_SECRET",
    "BASIC_AUTH_PASSWORD",
    "BASIC_AUTH_USERNAME",
    "COMPOSE_PROFILES",
    "DATABASE_CA",
    "DATABASE_CERT",
    "DATABASE_HOST",
    "DATABASE_KEY",
    "DATABASE_LOGGING",
    "DATABASE_MAX_CONNECTIONS",
    "DATABASE_NAME",
    "DATABASE_PASSWORD",
    "DATABASE_PORT",
    "DATABASE_REJECT_UNAUTHORIZED",
    "DATABASE_SSL_MODE",
    "DATABASE_USERNAME",
    "DOCKER_DATABASE_PORT",
    "DOCKER_GRAFANA_PORT",
    "DOCKER_MAIL_CLIENT_PORT",
    "DOCKER_MAIL_PORT",
    "DOCKER_PG_EXPORTER",
    "DOCKER_PROMETHEUS_PORT",
    "DOCKER_REDIS_PORT",
    "GITHUB_CLIENT_ID",
    "GITHUB_CLIENT_SECRET",
    "GRAFANA_PASSWORD",
    "GRAFANA_USERNAME",
    "IS_HTTPS",
    "IS_WORKER",
    "MAIL_DEFAULT_EMAIL",
    "MAIL_DEFAULT_NAME",
    "MAIL_HOST",
    "MAIL_IGNORE_TLS",
    "MAIL_PASSWORD",
    "MAIL_PORT",
    "MAIL_REQUIRE_TLS",
    "MAIL_SECURE",
    "MAIL_USER",
    "PRISMA_LOG_SLOW_MS",
    "PRISMA_MAX_QUERY_LENGTH",
    "PRISMA_REDACT_PARAMS",
    "QUEUE_FAILED_RETRY_ATTEMPTS",
    "QUEUE_REMOVE_ON_COMPLETE",
    "QUEUE_REMOVE_ON_FAIL",
    "REDIS_CA",
    "REDIS_CERT",
    "REDIS_KEY",
    "REDIS_REJECT_UNAUTHORIZED",
    "REDIS_TLS",
    "SENTRY_DSN",
    "SENTRY_LOGGING",
    "THROTTLER_ENABLED",
    "THROTTLER_LIMIT",
    "THROTTLER_TTL",
    "TZ"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "cache": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "outputs": ["coverage/**"],
      "dependsOn": ["^build"]
    }
  }
}
