{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "defaultProject": "server",
  "projects": {
    "server": {
      "type": "application",
      "root": "apps/server",
      "sourceRoot": "apps/server/src",
      "entryFile": "main",
      "compilerOptions": {
        "tsConfigPath": "apps/server/tsconfig.build.json",
        "builder": "swc",
        "typeCheck": true,
        "deleteOutDir": true,
        "assets": [
          { "include": "**/i18n/**/*", "watchAssets": true },
          { "include": "**/*.hbs", "watchAssets": true }
        ]
      }
    },
    "worker2": {
      "type": "application",
      "root": "apps/worker2",
      "sourceRoot": "apps/worker2/src",
      "entryFile": "main",
      "compilerOptions": {
        "tsConfigPath": "apps/worker2/tsconfig.build.json",
        "builder": "swc",
        "typeCheck": true,
        "deleteOutDir": true,
        "assets": []
      }
    }
  }
}
